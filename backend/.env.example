# Memo runs without any of these. They upgrade search from keyword to semantic.
#
#   no key, no Ollama -> keyword search (SQLite FTS5). Works offline, zero setup.
#   Ollama running    -> semantic search, free and private. `ollama pull nomic-embed-text`
#   OPENAI_API_KEY    -> semantic search plus note enrichment (claim, question, tags).

# OPENAI_API_KEY=sk-...

# auto (default) picks the best available: openai -> ollama -> keyword.
# Force one with: openai | ollama | none
# MEMO_EMBED_PROVIDER=auto

# MEMO_DB_PATH=memo.db
# MEMO_EMBED_DIM=768
# OLLAMA_HOST=http://localhost:11434
# MEMO_CHAT_MODEL=gpt-4o-mini
